# Copy to .env and fill locally. Never commit .env or paste secrets into chat.
BOT_TOKEN=replace_with_your_botfather_token
ADMIN_IDS=123456789
# Optional: send new requests and bookings to this group instead of admin private chats.
# Add the bot to your group and allow it to send messages. Buttons still require ADMIN_IDS.
# ADMIN_NOTIFICATION_CHAT_ID=-1001234567890
# Language for the shared group only; private notices use each admin's saved preference.
ADMIN_NOTIFICATION_LANGUAGE=en
POSTGRES_DB=smartlead
POSTGRES_USER=smartlead
# Use a strong URL-safe password, or percent-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_strong_url_safe_password
# Docker uses host 'db'. For a local install change it to 127.0.0.1.
DATABASE_URL=postgresql+asyncpg://smartlead:replace_with_a_strong_url_safe_password@db:5432/smartlead
# Optional: only after verifying a candidate with curl --resolve and normal TLS checks.
# Requires both compose.yaml and compose.telegram.yaml; leave unset for normal DNS.
# TELEGRAM_API_IP=
# Optional Docker test URL. Compose normally derives it from POSTGRES_PASSWORD.
# Set explicitly only when URL encoding is needed; keep the password in sync.
# TEST_DATABASE_URL=postgresql+asyncpg://smartlead_test:URL_ENCODED_PASSWORD@db_test:5432/smartlead_test

BUSINESS_NAME=SmartLead Studio
# Optional initial support Telegram contact. Administrators can edit it in /admin.
# Normal seed preserves the saved contact; use seed --sync-settings for an explicit sync.
BUSINESS_SUPPORT_CONTACT=
BUSINESS_TIMEZONE=Europe/London
BUSINESS_OPEN=09:00
BUSINESS_CLOSE=18:00
# Monday=0, Sunday=6. Same-day opening hours only.
BUSINESS_WEEKDAYS=0,1,2,3,4
SLOT_STEP_MINUTES=30
BOOKING_HORIZON_DAYS=14
BOOKING_NOTICE_MINUTES=60
OUTBOX_POLL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=8
LOG_LEVEL=INFO
